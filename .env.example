# Copy to .env for local development. Never commit .env.
# In production, put secrets in Docker secrets (/run/secrets/<name>) instead of env files.

# ─── App ───
ENVIRONMENT=development
BRAND_NAME=Nudgeline
NEXT_PUBLIC_BRAND_NAME=Nudgeline
PUBLIC_BASE_URL=https://localhost
CORS_ORIGINS=https://localhost,http://localhost:3000
ENABLE_API_DOCS=false
COOKIE_SECURE=false
# Long random string (e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`)
SECRET_KEY=
# Base64 32-byte key (e.g. `python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"`)
ENCRYPTION_MASTER_KEY=

# ─── Database ───
POSTGRES_USER=nudgeline
POSTGRES_PASSWORD=
POSTGRES_DB=nudgeline
APP_DB_PASSWORD=
# Only needed when running the API outside Docker:
DATABASE_URL=postgresql+asyncpg://nudgeline_app:CHANGE_ME@localhost:5432/nudgeline
DATABASE_URL_SYSTEM=postgresql+asyncpg://nudgeline:CHANGE_ME@localhost:5432/nudgeline

# ─── Speech (self-hosted) ───
# Dev default: light image with a beep instead of a voice. For real Arabic/English voices:
# SPEECH_WITH_MODELS=true and TTS_BACKEND=chatterbox (STT_BACKEND=whisper for speech-to-text).
SPEECH_WITH_MODELS=false
TTS_BACKEND=tone
STT_BACKEND=none
SPEECH_DEVICE=cpu

# ─── Telephony ───
# simulated = no real calls. livekit = real calls through LiveKit SIP (docker compose --profile voice).
TELEPHONY_BACKEND=simulated
SIMULATED_DIGIT=1
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=
LIVEKIT_SIP_TRUNK_ID=

# ─── Worker ───
WORKER_CONCURRENCY=5
