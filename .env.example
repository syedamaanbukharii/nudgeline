# ─── Database ───
DATABASE_URL=postgresql+asyncpg://nudgeline:nudgeline@pgbouncer:6432/nudgeline
DATABASE_URL_SYNC=postgresql://nudgeline:nudgeline@pgbouncer:6432/nudgeline
POSTGRES_USER=nudgeline
POSTGRES_PASSWORD=nudgeline
POSTGRES_DB=nudgeline

# ─── Valkey (Redis-compatible) ───
VALKEY_URL=valkey://valkey:6379/0

# ─── Keycloak ───
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=nudgeline
KEYCLOAK_CLIENT_ID=nudgeline-api
KEYCLOAK_CLIENT_SECRET=change-me
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ─── LiveKit ───
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret

# ─── SeaweedFS (S3-compatible) ───
S3_ENDPOINT_URL=http://seaweedfs:8333
S3_ACCESS_KEY=admin
S3_SECRET_KEY=admin
S3_BUCKET_RECORDINGS=recordings
S3_BUCKET_TRANSCRIPTS=transcripts

# ─── LLM Providers ───
GROQ_API_KEY=
GEMINI_API_KEY=

# ─── Observability ───
GLITCHTIP_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse:3001

# ─── App ───
ENVIRONMENT=development
ENABLE_API_DOCS=true
CORS_ORIGINS=http://localhost:3000
SECRET_KEY=change-me-in-production

# ─── Encryption ───
ENCRYPTION_MASTER_KEY=base64-encoded-32-byte-key-here

# ─── Frontend ───
NEXT_PUBLIC_API_URL=https://localhost/api
NEXT_PUBLIC_LIVEKIT_URL=wss://localhost:7880
